{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "vite",
    "generate:orvalapi": "orval --config ./orval.config.ts",
    "build": "tsc -b && vite build",
    "build:analyze": "npx vite-bundle-analyzer",
    "test": "vitest --watch=false",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "test:analyze": "npm run analyze:sonar",
    "pretest:analyze": "npm run test -- --coverage",
    "analyze:sonar": "dotenv -e .env -- docker run --rm -e SONAR_HOST_URL -e SONAR_TOKEN -v .:/usr/src sonarsource/sonar-scanner-cli",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.6",
    "@headlessui/react": "^1.7.19",
    "@loadable/component": "^5.16.3",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "dayjs": "^1.11.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.24.1",
    "react-toastify": "^10.0.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/loadable__component": "^5.13.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-legacy": "^5.4.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^24.1.0",
    "msw": "^2.14.6",
    "orval": "^8.17.0",
    "postcss": "^8.4.39",
    "shx": "^0.3.4",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^2.1.9"
  }
}
